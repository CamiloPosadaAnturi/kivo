# Copia este archivo como .env y llena los valores. El .env nunca se sube a
# git ni entra en la imagen de Docker: son tus secretos.

# --- Lo básico ---------------------------------------------------------------

# Clave con la que Django firma sesiones y formularios. Genera una nueva así:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en tu máquina. En el servidor SIEMPRE False: con True quedan
# expuestos el código y las variables en cualquier página de error.
DEBUG=True

# Dominios desde los que se sirve la app, separados por comas.
# Local: localhost,127.0.0.1   ·   Producción: kivo.com.co,www.kivo.com.co
ALLOWED_HOSTS=localhost,127.0.0.1

# Dominio público. Lo usan las URLs canónicas, el sitemap y la vista previa
# al compartir en WhatsApp o redes.
SITE_URL=http://localhost:8000

# --- Base de datos -----------------------------------------------------------

# En local (o con docker compose) se usan estas variables sueltas.
DB_NAME=kivo
DB_USER=kivo
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432

# Railway, Render y similares entregan la conexión en una sola variable. Si
# DATABASE_URL viene puesta, manda ella y las de arriba se ignoran.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

# --- Solo producción ---------------------------------------------------------

# Orígenes que pueden enviar formularios (con https://). Si lo dejas vacío se
# deduce de ALLOWED_HOSTS.
# CSRF_TRUSTED_ORIGINS=https://kivo.com.co,https://www.kivo.com.co

# Redirigir todo a https. Déjalo en True salvo que el proxy ya lo haga.
# SECURE_SSL_REDIRECT=True

# HSTS: obliga al navegador a usar https durante este tiempo. Empieza en 0 y
# súbelo a 31536000 (un año) cuando ya estés seguro del dominio.
# SECURE_HSTS_SECONDS=0

# Dominio para el certificado automático de Caddy (solo docker-compose.prod).
# DOMINIO=kivo.com.co
